{
  "name": "bolkhata-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node20 --out-dir dist --clean",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.2.0",
    "cors": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "^20",
    "@types/supertest": "latest",
    "supertest": "latest",
    "tsx": "latest",
    "typescript": "^5",
    "tsup": "latest",
    "vitest": "^4.0.0"
  }
}
